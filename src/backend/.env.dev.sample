# ============================================================================
# AZURE AI PROJECT (Required)
# ============================================================================
# Azure AI Project endpoint
AZURE_AI_PROJECT_ENDPOINT="https://your-ai-project-name.services.ai.azure.com/api/projects/your-project-name"
# Azure AI model deployment name
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o"

# ============================================================================
# OPENAI (Optional)
# ============================================================================
# OpenAI API key
OPENAI_API_KEY=""
# OpenAI chat model ID
OPENAI_CHAT_MODEL_ID=""
# OpenAI responses model ID
OPENAI_RESPONSES_MODEL_ID=""

# ============================================================================
# AZURE OPENAI (Required)
# ============================================================================
# Azure OpenAI service endpoint
AZURE_OPENAI_ENDPOINT="https://your-openai-resource-name.openai.azure.com/"
# Azure OpenAI API key
AZURE_OPENAI_KEY="your-azure-openai-api-key-here"
# Azure OpenAI chat deployment name
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4o"
# Azure OpenAI responses deployment name
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME="gpt-4o"
# Azure OpenAI text embedding deployment name
AZURE_OPENAI_ADA002_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# ============================================================================
# MEM0 (Optional)
# ============================================================================
# Mem0 API key
MEM0_API_KEY=""

# ============================================================================
# AZURE AI SEARCH (Required)
# ============================================================================
# Your Azure AI Search service endpoint
AZURE_AI_SERVICES_ENDPOINT="https://your-search-service-name.search.windows.net"
# Your Azure AI Search admin API key
AZURE_AI_SERVICES_KEY="your-azure-search-api-key-here"
AZURE_AI_INDEX_NAME="student-loan-guide-index"
# ============================================================================
# AZURE BLOB STORAGE (Required)
# ============================================================================
# Azure Storage Account name
AZURE_STORAGE_ACCOUNT="your-storage-account-name"
# Azure Storage Account connection string (enclose in quotes)
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-storage-account-name;AccountKey=your-storage-account-key-here;EndpointSuffix=core.windows.net"
# Blob container name
AZURE_STORAGE_CONTAINER="content"
BLOB_CONTAINER_NAME="agent-loan-processing"
# Azure Document Intelligence service endpoint
AZURE_DOCUMENT_INTELLIGENCE_SERVICE="https://your-document-intelligence-name.cognitiveservices.azure.com/"

# ============================================================================
# OBSERVABILITY (Optional)
# ============================================================================
# Enable OpenTelemetry logging
ENABLE_OTEL=true
# Enable sensitive data logging
ENABLE_SENSITIVE_DATA=true
# OpenTelemetry Protocol endpoint
OTLP_ENDPOINT="http://localhost:4317/"
# Application Insights connection string (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=your-instrumentation-key-here;IngestionEndpoint=https://region.in.applicationinsights.azure.com/;LiveEndpoint=https://region.livediagnostics.monitor.azure.com/;ApplicationId=your-application-id-here"